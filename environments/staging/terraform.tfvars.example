# Staging Environment Configuration
project_name   = "gd-ent"
environment    = "staging"
location       = "eastus"
location_short = "eus"
owner          = "StagingPlatformTeam"
cost_center    = "CC-STAGE-PLATFORM"
criticality    = "Tier-2-High-Availability"

# Network
hub_address_space   = ["10.0.0.0/16"]
spoke_address_space = ["10.1.0.0/16"]

# Feature Flags
enable_firewall            = true
firewall_sku_tier          = "Standard"
enable_bastion             = true
enable_vpn_gateway         = true
enable_application_gateway = true
enable_private_endpoints   = true
enable_cosmos_db           = true
enable_redis               = true
enable_monitoring          = true
enable_backup              = true

# Compute VMSS Sizing
frontend_vm_sku    = "Standard_D2s_v5"
frontend_instances = 2
backend_vm_sku     = "Standard_D2s_v5"
backend_instances  = 2

admin_username       = "azureuser"
admin_ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGX8a5dF+p1k93VqM5yL01bZl81234567890abcdefgh enterprise-admin@company.com"

# SQL Database Credentials
sql_admin_username = "sqladminuser"
sql_admin_password = "P@ssw0rdStaging2026!#Strong"
